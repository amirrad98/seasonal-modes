    "pointer": {
      "image": "images/cursor-pumpkin-32.png",
      "x": 16,
      "y": 16
    }
  },
  "intro": {
    "type": "crawl",
    "image": "images/spider.svg"
  },
  "credit": {
    "text": "Halloween graphics: %1$s (CC BY 4.0, resized) and a cobweb by tom via %2$s (CC0).",
    "links": [
