{
  "name": "Halloween",
  "version": "1.0.0",
  "window": {
    "start": "10-15",
    "end": "11-01"
  },
  "colors": {
    "accent": "#c2410c",
    "accentSoft": "#fed7aa",
    "ink": "#1c1917",
    "selectionBackground": "#fed7aa",
    "selectionText": "#1c1917",
    "dark": {
      "accent": "#fb923c",
      "accentSoft": "#7c2d12"
    }
  },
  "headerStripe": true,
  "logoBadge": {
    "image": "images/pumpkin.svg",
    "size": 22,
    "rotate": 14
  },
  "corners": {
    "image": "images/cobweb-corner.svg",
